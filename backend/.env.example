DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worknovas?schema=public"
PORT=4000
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
AGENT_API_KEY=change-me-agent-key
CORS_ORIGIN=http://localhost:5173

# Link base used in emails (the frontend origin)
APP_URL=http://localhost:5173

# Email (nodemailer/SMTP). Mail is disabled until SMTP_HOST is set; with it unset, invites and
# reset links are only logged/returned to the admin and OTP falls back to the fixed codes below.
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer: true on port 465, STARTTLS otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WorkNovas <no-reply@worknovas.com>"
# Set to false to switch delivery off without clearing the SMTP settings
MAIL_ENABLED=true

# Minutes an emailed verification code stays valid (accepted up to 2x during a window rollover)
OTP_TTL_MIN=10

# Fallback OTP codes: used for email while mail is disabled, and always for SMS (no SMS provider yet)
OTP_EMAIL_CODE=000000
OTP_SMS_CODE=111111

# Password given to users created from the admin panel while email is off. Leave unset to use invite links.
DEFAULT_USER_PASSWORD=
